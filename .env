# ============================================================
# OutpainterForAspectRatio2 settings
# ============================================================

# Папка с исходными изображениями
SRC_DIR=testImages

# Папка для результатов
OUT_DIR=output

# Целевое соотношение сторон:
#   screen            - как у текущего монитора (по умолчанию)
#   16x9 / 16:9 / 4x3 - явное соотношение
#   1.7778            - числовое значение (ширина/высота)
ASPECT_RATIO=screen

# Запасное разрешение экрана, если screen не определяется
SCREEN_FALLBACK=1920,1080

# Ограничения разрешения канвы. 2560/6МП достаточно для 4:5 -> 16:9
# без уменьшения оригинала (RTX 4090 24GB справляется).
MAX_LONG_SIDE=2560
MAX_PIXELS=6000000

# Параметры сэмплинга для базовой модели FLUX.2 Klein 4B (не distilled!)
# 50 шагов / CFG 4.0 / LoRA 1.1 — рекомендация модельной карточки LoRA
# (50 шагов / 4.0 / 1.1). 30 шагов давало шум/пятна в дорисованном фоне.
STEPS=50
CFG=4.0
LORA_STRENGTH=1.1

# Сид: -1 = случайный для каждого изображения
SEED=-1

# Маска: расширение (grow) и растушёвка (feather) границы в пикселях,
# BLEND - зона плавного перехода при наложении результата на оригинал
# (дефолт плагина selection_blend=25; композит-маска строится как в плагине:
# ThresholdMask(0.0) -> ShrinkMask(blend//2, blend))
GROW=16
FEATHER=8
BLEND=25

# Максимальная доля добавляемой рамки от меньшей стороны изображения.
# LoRA лучше всего работает при рамке 5-25% от размера изображения.
BORDER_MAX_RATIO=0.25
SKIP_LARGE_BORDER=false

# Многопроходность: большие рамки (> PASS_BORDER_RATIO) разбиваются на
# несколько проходов по <= PASS_BORDER_RATIO от текущей меньшей стороны.
# ВНИМАНИЕ: многопроходность оставляет тёмные полосы-тени на границах
# каждого прохода (по несколько на сторону). Поэтому по умолчанию выключена
# (один проход). Включайте только если нужен контроль шума на очень больших
# рамках и допустимы полосы на стыках проходов.
MULTI_PASS=false
PASS_BORDER_RATIO=0.25

# Пропускать изображения, у которых соотношение уже совпадает
SKIP_IF_MATCH=true

# Согласование цветов результата с оригиналом (INPAINT_ColorMatch),
# как в плагине по умолчанию (True)
COLOR_MATCH=true

# Продолжать с места остановки (по manifest.jsonl)
RESUME=true

# Промпт для outpainting (как в плагине krita-ai-diffusion)
PROMPT=Fill the green spaces according to the image.

# Таймаут ожидания одного изображения, секунд
# При многопроходности самый большой проход может занимать >80 мин
# из-за VRAM-транжинга на больших канвах (2304x1360+).
TIMEOUT_PER_IMAGE=5400

# Адрес ComfyUI
SERVER_URL=127.0.0.1:8188

# Директория сервера плагина krita-ai-diffusion
SERVER_DIR=j:\AI_Image_Enchance\ai_diffusion\server