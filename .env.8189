# ============================================================
# OutpainterForAspectRatio2 settings
# ============================================================

# Папка с исходными изображениями
SRC_DIR=testImages

# Папка для результатов
OUT_DIR=output

# Целевое соотношение сторон:
#   screen            - как у текущего монитора (по умолчанию)
#   16x9 / 16:9 / 4x3 - явное соотношение
#   1.7778            - числовое значение (ширина/высота)
ASPECT_RATIO=screen

# Запасное разрешение экрана, если screen не определяется
SCREEN_FALLBACK=1920,1080

# Ограничения разрешения канвы. 2560/6МП достаточно для 4:5 -> 16:9
# без уменьшения оригинала (RTX 4090 24GB справляется).
MAX_LONG_SIDE=2560
MAX_PIXELS=6000000

# Параметры сэмплинга: дефолт плагина = стиль "Flux 2 Klein"
# (styles/flux2-klein.json): пресет "Flux 2 - Euler" (euler/flux2),
# sampler_steps=4, cfg_scale=1.0.
# ВАЖНО: для FLUX.2 Klein cfg=1.0 -> BasicGuider без CFG. CFGGuider
# с cfg>1 даёт сильный высокочастотный шум в рамке.
STEPS=4
CFG=1.0
LORA_STRENGTH=1.0

# Сид: -1 = случайный для каждого изображения
SEED=-1

# Маска outpainting (0 = авто, как в плагине model.py calc_selection_pre_process):
#   feather = max(round(0.10 * диагональ канвы), 32), но не более ~6% от
#   меньшей стороны ОРИГИНАЛА — иначе зона денойза съедает всё фото и
#   диффузия перерисовывает (размывает) оригинал.
#   grow    = 4 + feather // 2
#   blend   = min(25, grow + feather // 2)
# Любое ненулевое значение переопределяет только этот параметр.
# Композитная маска строится как в плагине (workflow.py:941-945):
#   ExpandMask(grow, feather) -> ThresholdMask(0.0) -> ShrinkMask(blend//2, blend)
# Переход идёт ВНУТРИ оригинального фото, поэтому чёрных теней на стыке нет.
GROW=0
FEATHER=0
BLEND=0

# Максимальная доля добавляемой рамки от меньшей стороны изображения.
# LoRA лучше всего работает при рамке 5-25% от размера изображения.
BORDER_MAX_RATIO=0.25
SKIP_LARGE_BORDER=false

# 2-pass hi-res refine (как в плагине resolution.py): включается только если
# канва существенно превышает максимум модели (сторона > REFINE_MAX_LONG
# И pixels > REFINE_MAX_PIXELS с запасом). Проход 1 на уменьшенном разрешении,
# затем upscale + refine (strength 0.4) на полном.
REFINE_MAX_LONG=2048
REFINE_MAX_PIXELS=4000000
REFINE_UPSCALER=4x_NMKD-Superscale-SP_178000_G.pth

# Пропускать изображения, у которых соотношение уже совпадает
SKIP_IF_MATCH=true

# Согласование цветов результата с оригиналом (INPAINT_ColorMatch),
# как в плагине по умолчанию (True)
COLOR_MATCH=true

# Продолжать с места остановки (по manifest.jsonl)
RESUME=true

# Промпт для outpainting (как в плагине krita-ai-diffusion). LoRA outpaint
# обучена на зелёном маркере #00FF00: канвас заливается зелёным, поэтому
# плагин для FLUX.2 Klein использует FillMode.green, а не navier-stokes
# (workflow.py:968).
PROMPT=Fill the green spaces according to the image.

# Таймаут ожидания одного изображения, секунд
# При многопроходности самый большой проход может занимать >80 мин
# из-за VRAM-транжинга на больших канвах (2304x1360+).
TIMEOUT_PER_IMAGE=5400

# Адрес ComfyUI
SERVER_URL=127.0.0.1:8189

# Директория сервера плагина krita-ai-diffusion
SERVER_DIR=j:\AI_Image_Enchance\ai_diffusion\server